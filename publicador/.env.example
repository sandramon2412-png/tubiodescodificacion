# ── Seguridad ──────────────────────────────────────────────
# Contraseña que pide la app antes de publicar (obligatoria).
APP_PASSWORD=pon-aqui-una-contraseña-larga

# ── eBay (https://developer.ebay.com/my/keys) ─────────────
# "sandbox" para pruebas, "production" para publicar de verdad.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (no es una URL): Developer Portal → User Tokens → "Get a Token from eBay via Your Application".
# Su "auth accepted URL" debe ser https://TU-APP.vercel.app/api/ebay/callback
EBAY_RUNAME=
# Se obtiene al pulsar "Conectar eBay" en la app (dura ~18 meses).
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_CONTENT_LANGUAGE=en-US
# IDs de tus políticas de negocio (Seller Hub → Account → Business policies)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Clave de tu ubicación de inventario (se crea con la Inventory API / ver README)
EBAY_MERCHANT_LOCATION_KEY=

# ── Fotos ──────────────────────────────────────────────────
# Se crea sola al conectar un "Blob Store" en Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# ── Estudio con IA (opcional) ─────────────────────────────
# Escribe títulos, descripciones, SEO y precio a partir de las fotos.
# Crea la clave en https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Edita las fotos: quita el fondo, pone uno vintage con IA, sombras y quita arrugas.
# Plan "Plus" de https://www.photoroom.com/api — una clave que empieza por sandbox_ es gratis (con marca de agua) para probar.
PHOTOROOM_API_KEY=
